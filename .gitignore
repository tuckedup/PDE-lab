# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/

# Environment / tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
uv.lock

# Generated datasets (regenerate with `pdelab data generate`)
data/**/*.h5
data/**/*.npz
data/**/*.npy

# Run artifacts
runs/**/*.pt
runs/**/*.pth
runs/**/*.ckpt
runs/**/optimizer*.pt
results/**/*.png
results/**/*.pdf
results/**/*.gif

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Local release output
# scripts/linux/release_build.sh writes the release wheel, its SHA-256
# sidecar and the build summary into dist/.  The wheel is a build output
# and is never committed; RELEASE_MANIFEST.json and campaigns/release/
# ARE committed on purpose, because they are the release evidence.
dist/
campaigns/release/*.whl
campaigns/release/build/

# Secrets
.env
*.key
credentials*
